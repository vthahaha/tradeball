# Neon Postgres (Vercel sets these automatically; locally run: npx vercel env pull .env)
DATABASE_URL="postgresql://...pooled..."
DATABASE_URL_UNPOOLED="postgresql://...direct..."
SESSION_SECRET="change-me"
PACK_COOLDOWN_MINUTES=240

# Google sign-in (Google Cloud Console → Credentials → OAuth client, type "Web application").
# Redirect URIs: https://<your-site>/api/auth/google/callback and http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: force the public site URL used for the Google redirect
# APP_URL=https://tradeball.vercel.app

# Admins open packs without spending tickets (comma-separated usernames)
ADMIN_USERNAMES=
