# Neon Postgres (Vercel sets these automatically; locally run: npx vercel env pull .env)
DATABASE_URL="postgresql://...pooled..."
DATABASE_URL_UNPOOLED="postgresql://...direct..."
SESSION_SECRET="change-me"
PACK_COOLDOWN_MINUTES=240

# Local test accounts used during development: "tester" and "tester2", PIN "4242"

# Private league: if set, new accounts must enter this code. Leave empty for open sign-up.
INVITE_CODE=
